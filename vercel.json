{
  "buildCommand": "sh scripts/build_web.sh",
  "outputDirectory": "web/out",
  "functions": {
    "api/run.py": {
      "maxDuration": 300,
      "includeFiles": "{procurement,config,sample-data}/**",
      "excludeFiles": "{web,deck,video,docs,tests,reports,.git,.github,node_modules}/**"
    },
    "api/samples.py": {
      "maxDuration": 30,
      "includeFiles": "{procurement,config,sample-data}/**",
      "excludeFiles": "{web,deck,video,docs,tests,reports,.git,.github,node_modules}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
