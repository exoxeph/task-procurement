{
  "buildCommand": "cd web && npm ci && STATIC_EXPORT=1 API_MODE=live npm run build",
  "outputDirectory": "web/out",
  "functions": {
    "api/run.py": { "maxDuration": 300, "includeFiles": "{procurement,config,sample-data}/**" },
    "api/samples.py": { "maxDuration": 30, "includeFiles": "{procurement,config,sample-data}/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
